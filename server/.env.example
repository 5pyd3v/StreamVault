# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MySQL -- import server/schema.sql via phpMyAdmin or the mysql CLI first)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=streamvault
DB_POOL_SIZE=10

# JWT Configuration
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Storage Configuration
STORAGE_LOCAL_PATH=./uploads
UPLOAD_TEMP_PATH=./uploads/temp
STORAGE_PROVIDER=local

# File Upload Limits
CHUNK_SIZE_MB=5
MAX_FILE_SIZE_GB=100

# FFmpeg Configuration (optional - set if ffmpeg/ffprobe not in PATH)
FFMPEG_PATH=
FFPROBE_PATH=
# How many different VIDEOS may encode at once, server-wide. Each one is now a
# single ffmpeg process covering every quality rendition (see ENCODER_HWACCEL
# below), not one process per rendition, so this bound is the real ceiling on
# concurrent CPU/GPU load.
MAX_CONCURRENT_JOBS=4

# VOD encoding speed: single-decode, multi-output (one ffmpeg process handles
# every quality rendition at once) with hardware acceleration when available.
# ENCODER_HWACCEL         auto (default, probes the ffmpeg binary for NVENC/QSV/AMF
#                         and uses whichever is found) | nvenc | qsv | amf | software.
#                         If the resolved hardware backend fails to actually start
#                         (wrong GPU vendor / missing driver), the job automatically
#                         retries once with software libx264 -- check the encoder
#                         logs for "falling back to software" if this happens.
# ENCODER_NVENC_PRESET    NVENC preset (default p4) -- valid names vary slightly by
#                         ffmpeg/NVENC-SDK version; adjust here if the default errors.
# ENCODER_SOFTWARE_PRESET libx264 preset for the software fallback -- default is now
#                         `ultrafast` (the fastest x264 offers, biggest lever on
#                         CPU-only hardware with no GPU available; trades some
#                         compression efficiency -- larger files at the same CRF --
#                         for speed). Set to `superfast`/`veryfast`/etc. to favor
#                         file size/quality over raw encode speed instead. Threads
#                         are also now pinned explicitly to the detected CPU core
#                         count (`-threads`), since ffmpeg's own auto-detection is
#                         a known weak spot inside VMs/containers.
# HLS_PARALLEL_RENDITIONS how many renditions' HLS segmentation (a cheap stream-copy
#                         step) run concurrently (default 4).
# ENCODER_STALL_TIMEOUT_MS if ffmpeg produces zero output (not even startup banner
#                         lines) for this long, it's treated as hung and killed,
#                         then retried on software -- protects against silent
#                         hardware/driver init hangs (default 30000). Liveness is
#                         measured off ffmpeg's own `-progress pipe:1` heartbeat
#                         (always enabled), not the human-readable stderr stats
#                         line, which some ffmpeg builds don't emit at all when
#                         not attached to a terminal.
ENCODER_HWACCEL=auto
ENCODER_NVENC_PRESET=p4
ENCODER_SOFTWARE_PRESET=ultrafast
HLS_PARALLEL_RENDITIONS=4
ENCODER_STALL_TIMEOUT_MS=30000

# Resource-aware scheduling: live streaming always outranks background VOD
# work. A live broadcast is never gated by any of this -- these knobs only
# throttle new VOD job admission.
# MAX_CONCURRENT_JOBS_WHILE_LIVE how many VOD jobs may run at once while at
#                         least one channel is live (default 1, vs.
#                         MAX_CONCURRENT_JOBS's default 4 when idle) -- stops
#                         several broadcasts ending at once from all starting
#                         their replay encode simultaneously.
# MAX_CONCURRENT_HW_ENCODES ceiling on concurrent hardware-encode sessions
#                         (live + VOD combined) -- most consumer GPUs cap
#                         concurrent NVENC/QSV/AMF sessions at the driver
#                         level regardless of raw utilization, so this is the
#                         practical proxy for "is the hardware encoder busy."
#                         Live sessions always get a slot; VOD jobs beyond
#                         this ceiling run on software instead of contending
#                         for the GPU encoder (default 2).
# MAX_CPU_PERCENT_FOR_VOD / MAX_MEM_PERCENT_FOR_VOD  new VOD jobs wait in the
#                         queue while system CPU/memory usage is at or above
#                         these percentages (defaults 70 / 80).
MAX_CONCURRENT_JOBS_WHILE_LIVE=1
MAX_CONCURRENT_HW_ENCODES=2
MAX_CPU_PERCENT_FOR_VOD=70
MAX_MEM_PERCENT_FOR_VOD=80

# Live streaming (OBS -> RTMP ingest -> custom ffmpeg -> HLS under /uploads/hls/live)
# RTMP_PORT             port the node-media-server RTMP ingest listens on
# PUBLIC_RTMP_HOST      hostname handed to streamers in the OBS "Server" field
# LIVE_QUALITIES        comma-separated live ladder, low-to-high (valid rungs:
#                       360p, 480p, 720p, source). All-transcoded rungs share a
#                       forced-keyframe schedule so ABR switches stay frame-
#                       aligned (no audio overlap); "source" is an unaligned
#                       zero-CPU passthrough copy, kept for opt-in use only --
#                       mixing it with transcoded rungs can cause doubled/
#                       tripled audio on a quality switch.
# LIVE_HLS_SEGMENT_TIME live HLS target segment duration in seconds -- lower
#                       means lower glass-to-glass latency (default 2)
# LIVE_HLS_DVR_SECONDS  how far back a viewer can rewind live playback before
#                       segments roll off and are deleted from disk
# LIVE_POSTER_TIMEOUT_MS how long to wait for the first HLS segment before giving
#                       up on auto-capturing a poster for a channel with none
# MAX_POSTER_SIZE_MB    upload limit for admin-supplied channel poster images
# LIVE_STALL_TIMEOUT_MS how long a hardware live-encode attempt gets to prove
#                       it actually came up (via ffmpeg's `-progress` heartbeat)
#                       before falling back to software -- same silent-hang
#                       protection as VOD's ENCODER_STALL_TIMEOUT_MS (default
#                       30000)
# LIVE_RECONNECT_GRACE_MS how long to wait, after OBS disconnects, for the same
#                       stream key to republish before treating the broadcast
#                       as genuinely ended -- avoids flashing "stream ended" to
#                       every viewer (and prematurely finalizing a replay) for
#                       a brief network blip (default 10000)
RTMP_PORT=1935
PUBLIC_RTMP_HOST=localhost
LIVE_QUALITIES=360p,480p,720p
LIVE_HLS_SEGMENT_TIME=2
LIVE_HLS_DVR_SECONDS=180
LIVE_POSTER_TIMEOUT_MS=45000
MAX_POSTER_SIZE_MB=8
LIVE_STALL_TIMEOUT_MS=30000
LIVE_RECONNECT_GRACE_MS=10000

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StreamVault <noreply@example.com>"

# Socket.io
SOCKET_IO_PORT=5000
